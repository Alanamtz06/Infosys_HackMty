# TigerData / TimescaleDB (Postgres-compatible)
DATABASE_URL=postgresql://user:password@host:5432/lynx

# Google Gemini (auditoria de decisiones)
GEMINI_API_KEY=

# Punto de partida de la simulacion (Monterrey, ZMM)
CITY_CENTER_LAT=25.6714
CITY_CENTER_LON=-100.3095
CITY_RADIUS_KM=8

# Reloj virtual: minutos reales que representan un turno de 8 horas
SHIFT_DURATION_MINUTES=180

# CORS
FRONTEND_ORIGIN=http://localhost:5173
